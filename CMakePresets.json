{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 21,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "common",
			"hidden": true,
			"cacheVariables": {
				"F4SE_SUPPORT_XBYAK": "ON"
			},
			"binaryDir": "${sourceDir}/build"
		},
		{
			"name": "vcpkg",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
				"VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
			}
		},
		{
			"name": "win64",
			"hidden": true,
			"architecture": "x64",
			"cacheVariables": {
				"CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
			}
		},
		{
			"name": "msvc",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_CXX_FLAGS": "/EHsc /MP /W4 /WX $penv{CXXFLAGS}"
			},
			"generator": "Visual Studio 18 2026",
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "windows-msvc-x64",
					"enableMicrosoftCodeAnalysis": true,
					"enableClangTidyCodeAnalysis": true
				}
			}
		},
		{
			"name": "PRE-NG",
			"cacheVariables": {
				"BUILD_PRE_NG": true,
				"BUILD_POST_NG": false,
				"BUILD_POST_AE": false
			},
			"inherits": [
				"common",
				"vcpkg",
				"win64",
				"msvc"
			]
		},
		{
			"name": "POST-NG",
			"cacheVariables": {
				"BUILD_PRE_NG": false,
				"BUILD_POST_NG": true,
				"BUILD_POST_AE": false
			},
			"inherits": [
				"common",
				"vcpkg",
				"win64",
				"msvc"
			]
		},
		{
			"name": "POST-AE",
			"cacheVariables": {
				"BUILD_PRE_NG": false,
				"BUILD_POST_NG": false,
				"BUILD_POST_AE": true
			},
			"inherits": [
				"common",
				"vcpkg",
				"win64",
				"msvc"
			]
		}
	],
	"buildPresets": [
		{
			"name": "PRE-NG-DEBUG",
			"configurePreset": "PRE-NG",
			"configuration": "Debug"
		},
		{
			"name": "PRE-NG-RELEASE",
			"configurePreset": "PRE-NG",
			"configuration": "Release"
		},
		{
			"name": "PRE-NG-RELWDEBG",
			"configurePreset": "PRE-NG",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "POST-NG-DEBUG",
			"configurePreset": "POST-NG",
			"configuration": "Debug"
		},
		{
			"name": "POST-NG-RELEASE",
			"configurePreset": "POST-NG",
			"configuration": "Release"
		},
		{
			"name": "POST-NG-RELWDEBG",
			"configurePreset": "POST-NG",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "POST-AE-DEBUG",
			"configurePreset": "POST-AE",
			"configuration": "Debug"
		},
		{
			"name": "POST-AE-RELEASE",
			"configurePreset": "POST-AE",
			"configuration": "Release"
		},
		{
			"name": "POST-AE-RELWDEBG",
			"configurePreset": "POST-AE",
			"configuration": "RelWithDebInfo"
		}
	]
}